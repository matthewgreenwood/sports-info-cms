    },
    "country": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "question": {
      "type": "text"
    },
    "response": {
      "type": "text"
    },
    "send_response": {
      "type": "boolean",
      "default": false
    },
    "question_reference": {
      "type": "string"
    },
    "response_sent_at": {
      "type": "datetime"
    }
  }
