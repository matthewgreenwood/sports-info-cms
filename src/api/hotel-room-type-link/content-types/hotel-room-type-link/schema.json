      "enum": [
        "Room Only",
        "Bed & Breakfast",
        "Half Board",
        "Full Board"
      ]
    },
    "hotel_room_inventory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::hotel-room-inventory.hotel-room-inventory",
