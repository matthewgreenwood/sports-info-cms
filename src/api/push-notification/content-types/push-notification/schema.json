{
  "kind": "collectionType",
  "collectionName": "push_notifications",
  "info": {
    "singularName": "push-notification",
    "pluralName": "push-notifications",
    "displayName": "Push Notifications"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "send_after": {
      "type": "datetime"
    },
    "send_push": {
      "type": "boolean",
      "default": false
    },
    "segment": {
      "type": "json",
      "customField": "global::segment-checkboxes"
    },
    "push_sent": {
      "type": "boolean"
    }
  }
}
