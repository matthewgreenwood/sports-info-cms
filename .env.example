# Generate two unique random strings of at least 32 characters each, comma-separated
# Example: node -e "console.log([...Array(2)].map(()=>require('crypto').randomBytes(32).toString('base64')).join(','))"
APP_KEYS=<REPLACE_WITH_TWO_RANDOM_BASE64_STRINGS_COMMA_SEPARATED>
